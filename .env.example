# Copy this file to the ignored .env file and replace placeholders locally.
# Every variable below is a formal decision_agent.config.Settings alias.

# Basic configuration
DECISION_AGENT_APP_NAME=Enterprise Decision Agent
DECISION_AGENT_ENVIRONMENT=development
DECISION_AGENT_DEPLOYMENT_MODE=private
# Public demo is opt-in. See docs/deployment/P1_PUBLIC_DEMO.md before enabling it.
# Generate an independent signing secret with secrets.token_urlsafe(32); never commit it.
DECISION_AGENT_PUBLIC_DEMO_ORIGIN=
DECISION_AGENT_PUBLIC_DEMO_SIGNING_SECRET=
DECISION_AGENT_PUBLIC_DEMO_COOKIE_TTL_SECONDS=1800
DECISION_AGENT_PUBLIC_DEMO_MAX_ACTIVE=2
DECISION_AGENT_PUBLIC_DEMO_REQUESTS_PER_VISITOR=10
DECISION_AGENT_PUBLIC_DEMO_REQUESTS_GLOBAL=60
DECISION_AGENT_PUBLIC_DEMO_BOOTSTRAPS_GLOBAL=120
DECISION_AGENT_PUBLIC_DEMO_WINDOW_SECONDS=60
DECISION_AGENT_PUBLIC_DEMO_MAX_VISITORS=1000
DECISION_AGENT_PUBLIC_DEMO_MAX_BODY_BYTES=65536
DECISION_AGENT_PUBLIC_DEMO_BODY_TIMEOUT_SECONDS=10
DECISION_AGENT_REQUIRED_DEPENDENCIES=[]

# Docker Compose bootstrap only. Replace these obvious local-demo placeholders if needed.
MYSQL_ROOT_PASSWORD=change-me-for-local-demo

# Formal Runtime LLM configuration: all three marked REQUIRED must be provided together.
DECISION_AGENT_LLM_API_KEY=replace-with-runtime-api-key # REQUIRED
DECISION_AGENT_LLM_BASE_URL=https://llm.example.invalid/v1 # REQUIRED
DECISION_AGENT_LLM_MODEL_NAME=replace-with-runtime-model # REQUIRED
DECISION_AGENT_LLM_TIMEOUT_SECONDS=30
DECISION_AGENT_CONTROLLED_WORKFLOW_ENABLED=false

# Knowledge dataset and model configuration
DECISION_AGENT_KNOWLEDGE_DATASET_ROOT=./datasets/enterprise_kb/m2c1 # REQUIRED
DECISION_AGENT_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
DECISION_AGENT_EMBEDDING_MODEL_REVISION=
DECISION_AGENT_EMBEDDING_DIMENSION=512
DECISION_AGENT_EMBEDDING_DEVICE=cpu
DECISION_AGENT_EMBEDDING_BATCH_SIZE=32
DECISION_AGENT_EMBEDDING_NORMALIZE=true
DECISION_AGENT_EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages: 
DECISION_AGENT_EMBEDDING_CACHE_FOLDER=
DECISION_AGENT_EMBEDDING_LOCAL_FILES_ONLY=false
DECISION_AGENT_EMBEDDING_TRUST_REMOTE_CODE=false
DECISION_AGENT_EMBEDDING_SHOW_PROGRESS=false
DECISION_AGENT_RERANKER_MODEL_NAME=BAAI/bge-reranker-base
DECISION_AGENT_RERANKER_MODEL_REVISION=
DECISION_AGENT_RERANKER_DEVICE=cpu
DECISION_AGENT_RERANKER_BATCH_SIZE=8

# Milvus configuration
DECISION_AGENT_MILVUS_URI=http://127.0.0.1:19530
DECISION_AGENT_MILVUS_TOKEN=
DECISION_AGENT_MILVUS_DATABASE=default
DECISION_AGENT_MILVUS_COLLECTION=decision_agent_chunks
DECISION_AGENT_MILVUS_DIMENSION=512
DECISION_AGENT_MILVUS_METRIC_TYPE=COSINE
DECISION_AGENT_MILVUS_INDEX_TYPE=HNSW
DECISION_AGENT_HNSW_M=16
DECISION_AGENT_HNSW_EF_CONSTRUCTION=200
DECISION_AGENT_HNSW_EF_SEARCH=64
DECISION_AGENT_MILVUS_TIMEOUT_SECONDS=10

# MCP configuration
DECISION_AGENT_MCP_TIMEOUT_SECONDS=10

# Formal non-test Runtime requires a path outside the repository for payload-free Audit JSONL.
# Cloud launcher uses stdout when explicitly selected; local demos always use file.
DECISION_AGENT_AUDIT_MODE=file
DECISION_AGENT_RUNTIME_REVISION=local
DECISION_AGENT_RELEASE_ID=unversioned
DECISION_AGENT_CORPUS_RELEASE_ID=unversioned
DECISION_AGENT_AUDIT_LOG_PATH=../decision-agent-runtime/audit/events.jsonl

# Read-only database configuration
DECISION_AGENT_DB_HOST=127.0.0.1
DECISION_AGENT_DB_PORT=3306
DECISION_AGENT_DB_DATABASE=enterprise_operations
DECISION_AGENT_DB_READONLY_USERNAME=decision_agent_readonly
DECISION_AGENT_DB_READONLY_PASSWORD=change-me-for-local-demo-readonly # REQUIRED
DECISION_AGENT_DB_CONNECT_TIMEOUT_SECONDS=5
DECISION_AGENT_DB_QUERY_TIMEOUT_SECONDS=5
DECISION_AGENT_DB_MAX_ROWS=200
DECISION_AGENT_DB_MAX_RESULT_CELLS=2000

# Memory mode: disabled, in_memory, or redis.
# Redis URL is used only in redis mode. Current Settings require a scheme and host and reject
# embedded user information, so authentication cannot be embedded in this URL.
# Summary settings take effect only when summary is enabled and Memory is not disabled.
DECISION_AGENT_MEMORY_MODE=disabled
DECISION_AGENT_MEMORY_REDIS_URL=
DECISION_AGENT_MEMORY_REDIS_TIMEOUT_SECONDS=5
DECISION_AGENT_MEMORY_TTL_SECONDS=1800
DECISION_AGENT_MEMORY_MAX_TURNS=20
# In-memory session count; expired sessions are reclaimed, live history is not evicted.
DECISION_AGENT_MEMORY_MAX_SESSIONS=1000
DECISION_AGENT_MEMORY_SUMMARY_ENABLED=false
DECISION_AGENT_MEMORY_SUMMARY_TRIGGER_TURNS=6
DECISION_AGENT_MEMORY_SUMMARY_RETAIN_RECENT_TURNS=2
DECISION_AGENT_MEMORY_SUMMARY_MAX_SOURCE_CHARS=8000
DECISION_AGENT_MEMORY_SUMMARY_MAX_SUMMARY_CHARS=2000

# P3: immutable cloud release (optional locally); image sets baked local model paths.
DECISION_AGENT_RERANKER_CACHE_FOLDER=
DECISION_AGENT_RERANKER_LOCAL_FILES_ONLY=false
DECISION_AGENT_RELEASE_MANIFEST_PATH=
# P4: Cloud SQL socket overrides TCP, including inside the owned MCP child.
DECISION_AGENT_DB_UNIX_SOCKET=
DECISION_AGENT_DB_POOL_SIZE=2
DECISION_AGENT_DB_POOL_TIMEOUT_SECONDS=5
# DECISION_AGENT_MILVUS_INDEX_TYPE supports HNSW (local) or AUTOINDEX (Zilliz).
# P6 total cooperative API execution deadline, below the 300-second transport timeout.
DECISION_AGENT_REQUEST_EXECUTION_TIMEOUT_SECONDS=240
