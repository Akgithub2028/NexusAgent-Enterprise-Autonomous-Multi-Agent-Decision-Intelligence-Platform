# Use the baked release manifest; changing corpus/model/collection independently fails closed.
DECISION_AGENT_DEPLOYMENT_MODE=public_demo
DECISION_AGENT_CONTROLLED_WORKFLOW_ENABLED=true
DECISION_AGENT_AUDIT_MODE=stdout
DECISION_AGENT_MEMORY_MODE=in_memory
DECISION_AGENT_MEMORY_MAX_SESSIONS=1000
DECISION_AGENT_MILVUS_URI=https://in03-58be74b5a71aa09.serverless.gcp-us-west1.cloud.zilliz.com
DECISION_AGENT_MILVUS_INDEX_TYPE=AUTOINDEX
DECISION_AGENT_MILVUS_DATABASE=default
DECISION_AGENT_DB_UNIX_SOCKET=/cloudsql/nexus-agent-510512:us-west1:nexus-demo-mysql
DECISION_AGENT_DB_POOL_SIZE=2
DECISION_AGENT_DB_POOL_TIMEOUT_SECONDS=5
DECISION_AGENT_DB_READONLY_USERNAME=decision_agent_readonly
DECISION_AGENT_DB_DATABASE=enterprise_operations
DECISION_AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
DECISION_AGENT_LLM_MODEL_NAME=openai/gpt-oss-20b
# Set the actual canonical HTTPS origin only after a restricted Cloud Run revision exists (P6).
DECISION_AGENT_PUBLIC_DEMO_ORIGIN=https://SET_ACTUAL_SERVICE_HOST
# Inject pinned Secret Manager versions, never copy secret values here:
# DECISION_AGENT_LLM_API_KEY=nexus-groq-key:<numeric version>
# DECISION_AGENT_MILVUS_TOKEN=nexus-vector-read-token:<numeric version>
# DECISION_AGENT_DB_READONLY_PASSWORD=nexus-db-reader-password:<numeric version>
# DECISION_AGENT_PUBLIC_DEMO_SIGNING_SECRET=nexus-demo-signing-key:<numeric version>

# P6 Cloud Run deployment preference confirmed: min instances 1, max instances 1.
