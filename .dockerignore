# Allowlist prevents local credentials, caches, audit records and Git entering build context.
**
!Dockerfile
!pyproject.toml
!README.md
!src/
!src/**
!scripts/
!scripts/prepare_cloud_release.py
!scripts/validate_cloud_image.py
!deploy/
!deploy/cloud-run/
!deploy/cloud-run/requirements-runtime.lock
!deploy/cloud-run/requirements-build.lock
!deploy/cloud-run/corpus-release.json
!datasets/
!datasets/enterprise_kb/
!datasets/enterprise_kb/m2c1/
!datasets/enterprise_kb/m2c1/documents/
!datasets/enterprise_kb/m2c1/documents/*.md
!datasets/enterprise_kb/m2c1/document_manifest.json
!datasets/enterprise_kb/m2c1/generated/
!datasets/enterprise_kb/m2c1/generated/parent_chunks.jsonl
!datasets/enterprise_kb/m2c1/generated/child_chunks.jsonl
**/__pycache__/**
**/*.pyc
**/.env
**/.env.*
**/*.pem
**/*.key
**/.git/**

**/gha-creds-*.json
